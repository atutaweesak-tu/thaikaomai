# Admin Users
# รหัสผ่านเก็บเป็น bcrypt hash เท่านั้น ห้ามใส่ plaintext
# สร้าง hash ด้วย: node scripts/hashPassword.mjs "your-password-here"
#
# ADMIN_n_ROLE (ไม่บังคับ): super_admin หรือ admin
#   - super_admin เห็น/จัดการได้ทุกแท็บ รวมถึง "ตั้งค่าเว็บ" และ "ผู้ดูแล"
#   - admin (ค่าเริ่มต้นถ้าไม่ตั้ง ยกเว้น ADMIN_1 ซึ่ง default เป็น super_admin) เห็นได้ทุกแท็บยกเว้น settings/users
# ADMIN_n_TABS (ไม่บังคับ): จำกัดแท็บเฉพาะ เช่น "news,events" — ใช้เมื่อต้องการให้ admin คนนั้นดูแลได้แค่บางส่วน
#   ค่าที่ใช้ได้: news, events, policies, team, newsletter, contact, volunteer, users, settings
ADMIN_1_EMAIL=admin1@example.com
ADMIN_1_PASSWORD_HASH=$2a$12$replace-with-output-of-hashPassword-script
ADMIN_1_NAME=Admin 1
ADMIN_1_ROLE=super_admin
ADMIN_2_EMAIL=admin2@example.com
ADMIN_2_PASSWORD_HASH=$2a$12$replace-with-output-of-hashPassword-script
ADMIN_2_NAME=Admin 2
ADMIN_2_ROLE=admin
# ตัวอย่างแอดมินในอนาคตที่ดูแลได้แค่ข่าว/กิจกรรม:
# ADMIN_3_EMAIL=editor@example.com
# ADMIN_3_PASSWORD_HASH=$2a$12$replace-with-output-of-hashPassword-script
# ADMIN_3_NAME=Editor
# ADMIN_3_ROLE=admin
# ADMIN_3_TABS=news,events

# Email (SMTP) — แจ้งเตือนเมื่อมี Contact / Newsletter ใหม่
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-app-password
SMTP_TO=notify@example.com

# ─────────────────────────────────────────────────────────────────────────────
# ThaID KYC verification broker (server/verify/) — ปิดอยู่โดย default
# รายละเอียด + สัญญาฝั่ง api/SPA ดู server/verify/README.md
#
# ตัวแปรเหล่านี้อ่านโดย: broker (server/verify/) เสมอ; ฝั่ง api (/opt/thaikaomai/api)
# ต้องตั้ง VERIFY_S2S_SECRET + VERIFY_FIELD_KEY "ค่าเดียวกัน" ด้วย (ดู integration/)
# ─────────────────────────────────────────────────────────────────────────────
VERIFY_ENABLED=false                 # true เท่านั้นถึงเปิด route (ไม่งั้นทุก path ตอบ 404)
VERIFY_DRIVER=stub                   # stub (default) | oidc (ก้อน D — ต้องตั้ง THAID_* ครบ)
VERIFY_STUB_AUTOPASS=false           # stub จำลองผล "ผ่าน" — local/staging เท่านั้น

# ความปลอดภัย (บังคับเมื่อ VERIFY_ENABLED=true)
# ตั้งตรงนี้ตรงๆ ได้เฉพาะ local/dev/test เท่านั้น — production ต้องมาจาก Vault แทน
# (ตั้ง VAULT_ADDR ด้านล่าง แล้วลบ 3 บรรทัดนี้ทิ้งได้เลย broker จะดึงจาก Vault ตอน boot
# แทน — ดู server/verify/vaultClient.ts + server/verify/integration/vault/README.md)
VERIFY_S2S_SECRET=                    # shared secret broker⇄api สำหรับ HMAC, >= 32 ตัว
VERIFY_FIELD_KEY=                     # AES-256-GCM key: hex 64 ตัว หรือ base64 ของ 32 bytes
VERIFY_PID_PEPPER=                    # HMAC pepper hash เลขบัตร (ฝั่ง broker เท่านั้น), >= 16 ตัว

# Vault (secret manager) — production ควรตั้งชุดนี้แทนการเขียน VERIFY_FIELD_KEY/
# VERIFY_S2S_SECRET/VERIFY_PID_PEPPER ตรงๆ ด้านบน (GO-LIVE.md ข้อ 2, DPIA.md R9)
# ไม่ตั้ง VAULT_ADDR ไว้ = ใช้ค่า VERIFY_* จาก .env ตรงๆ ตามเดิม (local/dev/test)
# ตั้ง setup ครั้งแรกที่ server/verify/integration/vault/setup-approle.sh
VAULT_ADDR=                           # เช่น http://vault:8200 (service name บน thaikaomai_appnet)
VAULT_ROLE_ID=                        # จาก setup-approle.sh
VAULT_SECRET_ID=                      # จาก setup-approle.sh — หมุนได้ถ้าสงสัยว่าหลุด (ดู README ใน vault/)
VAULT_VERIFY_SECRET_PATH=secret/data/thaikaomai/verify  # ปกติไม่ต้องเปลี่ยน

# URLs
VERIFY_PUBLIC_BASE=https://thaikaomai.or.th
VERIFY_DONE_REDIRECT=https://www.thaikaomai.or.th/register/verify-done
VERIFY_LARAVEL_INGEST_URL=http://127.0.0.1:9000/api/verify/callback-ingest  # ชื่อ env คงเดิม แม้ api ไม่ใช่ Laravel

# S2S allowlist (defense-in-depth — ตัวหลักคือ HMAC)
VERIFY_ALLOWED_S2S_IPS=127.0.0.1,::1
VERIFY_S2S_TRUST_ALL_IPS=false       # true = testing เท่านั้น

VERIFY_SESSION_TTL_SECONDS=1800       # อายุ broker session
VERIFY_PREFILL_TTL_SECONDS=600        # (ฝั่ง api) อายุ verify_prefill_cache — SPA ต้อง consume ภายในเวลานี้

# ThaID OIDC (เว้นว่างจนกว่าจะได้ Relying Party จาก DOPA; ใช้เมื่อ VERIFY_DRIVER=oidc)
THAID_CLIENT_ID=
THAID_CLIENT_SECRET=
THAID_REDIRECT_URI=https://thaikaomai.or.th/verify/callback
THAID_AUTHORIZE_URL=
THAID_TOKEN_URL=
THAID_USERINFO_URL=
THAID_JWKS_URL=
THAID_ISSUER=                         # default = origin ของ THAID_AUTHORIZE_URL
THAID_SCOPES=pid name birthdate address
THAID_REQUIRED_IAL=2.3
THAID_TOKEN_AUTH=basic                # basic | post
THAID_ACR_VALUES=
THAID_CLOCK_SKEW_SECONDS=60

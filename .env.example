# Admin Users
# รหัสผ่านเก็บเป็น bcrypt hash เท่านั้น ห้ามใส่ plaintext
# สร้าง hash ด้วย: node scripts/hashPassword.mjs "your-password-here"
#
# ADMIN_n_ROLE (ไม่บังคับ): super_admin หรือ admin
#   - super_admin เห็น/จัดการได้ทุกแท็บ รวมถึง "ตั้งค่าเว็บ" และ "ผู้ดูแล"
#   - admin (ค่าเริ่มต้นถ้าไม่ตั้ง ยกเว้น ADMIN_1 ซึ่ง default เป็น super_admin) เห็นได้ทุกแท็บยกเว้น settings/users
# ADMIN_n_TABS (ไม่บังคับ): จำกัดแท็บเฉพาะ เช่น "news,events" — ใช้เมื่อต้องการให้ admin คนนั้นดูแลได้แค่บางส่วน
#   ค่าที่ใช้ได้: news, events, policies, team, newsletter, contact, volunteer, users, settings
ADMIN_1_EMAIL=admin1@example.com
ADMIN_1_PASSWORD_HASH=$2a$12$replace-with-output-of-hashPassword-script
ADMIN_1_NAME=Admin 1
ADMIN_1_ROLE=super_admin
ADMIN_2_EMAIL=admin2@example.com
ADMIN_2_PASSWORD_HASH=$2a$12$replace-with-output-of-hashPassword-script
ADMIN_2_NAME=Admin 2
ADMIN_2_ROLE=admin
# ตัวอย่างแอดมินในอนาคตที่ดูแลได้แค่ข่าว/กิจกรรม:
# ADMIN_3_EMAIL=editor@example.com
# ADMIN_3_PASSWORD_HASH=$2a$12$replace-with-output-of-hashPassword-script
# ADMIN_3_NAME=Editor
# ADMIN_3_ROLE=admin
# ADMIN_3_TABS=news,events

# Email (SMTP) — แจ้งเตือนเมื่อมี Contact / Newsletter ใหม่
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-app-password
SMTP_TO=notify@example.com
